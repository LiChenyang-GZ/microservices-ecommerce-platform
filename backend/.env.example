# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Each service imports it via spring.config.import in application.properties;
# real environment variables override these values.
DB_USERNAME=postgres
DB_PASSWORD=
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=
# Gmail address + 16-char app password (not your Gmail login password)
MAIL_USERNAME=
MAIL_PASSWORD=
# At least 64 characters for HS512
JWT_SECRET=
