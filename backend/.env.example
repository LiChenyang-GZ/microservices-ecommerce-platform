# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Two readers use the same file:
#   - docker compose fills ${...} in compose.yml from it, and passes each
#     container only the values that container needs;
#   - a service started outside Docker (bootRun / IDE) imports it via
#     spring.config.import in application.properties.
# Real environment variables override these values.

# PostgreSQL superuser. Only the postgres container gets this one.
POSTGRES_PASSWORD=

# Database per service: login <service>_user on database <service>_db.
# Created on the first start of an empty data volume
# (backend/docker/postgres/init). Changing them later needs: docker compose down -v
STORE_DB_PASSWORD=
BANK_DB_PASSWORD=
DELIVERY_DB_PASSWORD=
EMAIL_DB_PASSWORD=
TRACKING_DB_PASSWORD=

RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=

# Gmail address + 16-char app password (not your Gmail login password)
MAIL_USERNAME=
MAIL_PASSWORD=

# At least 64 characters for HS512
JWT_SECRET=
